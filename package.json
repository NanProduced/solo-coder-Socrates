    "package": "plasmo package"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@plasmohq/storage": "^1.15.0",
    "pdfjs-dist": "^5.6.205",
    "plasmo": "0.90.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.1.40",
    "@types/mozilla-readability": "^0.2.1",
    "@types/node": "22.13.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.14",
    "typescript": "5.7.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
      "activeTab",
      "storage",
      "scripting"
    ]
